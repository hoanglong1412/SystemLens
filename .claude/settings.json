{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/fix-format.ps1\"",
            "timeout": 30,
            "statusMessage": "Normalizing UTF-8 + CRLF..."
          }
        ]
      }
    ]
  }
}
